# Copy to .env.local. Base URL of the Django backend (Docker compose sets this too).
VITE_API_URL=http://localhost:8000

# Interpreter sessions: there is no booking backend yet. Set to true to see sample data.
# VITE_MOCK_INTERPRETER_SESSIONS=true
# Interpreter wallet: there is no payments backend yet. Set to true to see sample data.
# VITE_MOCK_INTERPRETER_WALLET=true
